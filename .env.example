VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# All OutreachOps controls default to false. These flags only gate UI exposure;
# future Edge Functions must enforce safety rules independently.
VITE_OUTREACH_OPS_ENABLED=false
VITE_AI_DRAFT_GENERATION_ENABLED=false
VITE_AI_RUNTIME_ENABLED=false
VITE_AI_RESEARCH_ENABLED=false
VITE_GMAIL_CONNECTION_ENABLED=false
VITE_CONTROLLED_SEND_ENABLED=false

# Gmail connection is a server-side OAuth capability. Keep it disabled until
# CRM-GMAIL-00A production acceptance and set real values only as Edge Function
# secrets, never in a committed .env file.
GMAIL_CONNECTION_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
APP_BASE_URL=
